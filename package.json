{
  "name": "dsh-memory-nian",
  "version": "0.1.0",
  "description": "自托管记忆系统插件：四层 SQLite 记忆库（核心 / 项目 / 分支 / 细节，每层带分类）+ BM25 检索（含拼音与首字母容错）+ 首轮快照与每轮命中注入 + 10 个 memory_* 工具。零运行时依赖，拼音库已 vendor。",
  "type": "module",
  "author": "念 (Nian)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=23.4.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "bm25",
    "sqlite",
    "self-hosted",
    "cjk",
    "pinyin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
