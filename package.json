{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "自托管记忆系统插件：七层 SQLite 记忆库 + BM25 检索（含拼音与首字母容错）+ 首轮/每轮注入 + 七个 memory_* 工具。零运行时依赖，拼音库已 vendor。",
  "type": "module",
  "author": "念 (Nian)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "bm25",
    "sqlite",
    "self-hosted",
    "cjk",
    "pinyin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
